@page "/students"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Студенты</PageTitle>

<div class="controls">
    <h1>Студенты:</h1>

    <p>
        <a href="students/create" class="btn btn-primary">Добавить</a>
    </p>
    <form action="/students">
        <input type="search" name="studentFilter" />
        <input type="submit" value="Найти" />
    </form>
    <div>
        <label for="items-per-page">Элементов на странице: </label>
        <select @bind="pagination.ItemsPerPage" id="items-per-page">
            <option value="3">3</option>
            <option value="5">5</option>
            <option value="8">8</option>
            <option value="10">10</option>
        </select>
    </div>
</div>

<QuickGrid Class="table" Items="FilteredStudents2" Pagination="pagination">
@*     <PropertyColumn Property="student => student.last_name" title="Фамилия"/>
    <PropertyColumn Property="student => student.first_name" title="Имя"/>
    <PropertyColumn Property="student => student.middle_name" title="Отчество"/> *@
    @* <PropertyColumn Property="student => student.FullName" title="ФИО" Sortable="true"/> *@
     <TemplateColumn Context="student" Title="ФИО" Sortable="true" SortBy="sortBy">
        <a href="@($"students/details?stud_id={student.stud_id}")">@student.FullName</a>
    </TemplateColumn>
    <PropertyColumn Property="student => student.birth_date" title="Дата рождения" Sortable="true" />
    <TemplateColumn Context="student" Title="Возраст" Sortable="true" SortBy="GridSort<Student>.ByDescending(e => e.birth_date)">
        @student.Age
    </TemplateColumn>
    <PropertyColumn Property="student => student.Group.group_name" title="Группа" Sortable="true" />
    <PropertyColumn Property="student => student.Group.Direction.direction_name" title="Направление обучения" Sortable="true" />
@*     <PropertyColumn Property="student => student.email" />
    <PropertyColumn Property="student => student.phone" /> *@

@*     <TemplateColumn Context="student">
        <a href="@($"students/edit?stud_id={student.stud_id}")">Edit</a> |
        <a href="@($"students/details?stud_id={student.stud_id}")">Details</a> |
        <a href="@($"students/delete?stud_id={student.stud_id}")">Delete</a>
    </TemplateColumn> *@
</QuickGrid>
<Paginator State="pagination"></Paginator>

@code {
    private AcademyContext context = default!;
    IQueryable<Student> students = default!;

    GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name)
    .ThenAscending(s => s.first_name);

    PaginationState pagination = new PaginationState { ItemsPerPage = 3 };

    [SupplyParameterFromQuery]
    string? StudentFilter { get; set; }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        students = context.Students.Include(s => s.Group).ThenInclude(g => g.Direction);
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();

    IQueryable<Student> FilteredStudents =>
context.Students.Where(m => m.FullName.Contains(StudentFilter ?? string.Empty));

    IQueryable<Student> FilteredStudents2 =>
        context.Students
            .Include(s => s.Group).ThenInclude(g => g.Direction)
            .Where(s => string.IsNullOrEmpty(StudentFilter)
                || s.last_name.Contains(StudentFilter ?? string.Empty));
}
