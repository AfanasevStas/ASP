@* <h3>Фото:</h3> *@


    <div class="photo-area">
        <div>
            @if (Human.photo != null)
            {
                <img src="data:image;base64,@Convert.ToBase64String(Human.photo)" alt="Photo"/>
            }
        </div>
        @if (AllowChange)
        {
            <InputFile OnChange="LoadPhoto" class="form-control choose-photo"/>
        }
    </div>

@code 
{
    [Parameter]
    public Models.Human Human { get; set; }
    [Parameter]
    public bool AllowChange { get; set; }
    [Parameter]
    public EventCallback<byte[]> OnPhotoChanged { get; set; }

    IBrowserFile url { get; set; }
    async Task LoadPhoto(InputFileChangeEventArgs e)
    {
        url = e.File;
        MemoryStream memoryStream = new MemoryStream();
        await url.OpenReadStream(1024*1024*10).CopyToAsync(memoryStream);
        byte[] bytes = memoryStream.ToArray();

        Human.photo = bytes;
        await OnPhotoChanged.InvokeAsync(bytes);
        memoryStream.Close();
    }
}
