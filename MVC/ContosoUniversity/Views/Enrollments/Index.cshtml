@* @model IEnumerable<ContosoUniversity.Models.Enrollment> *@
@model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Enrollment</h1>
    <form asp-action="Index" method="get">
        <label>
            Поиск по названию:
            <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Поиск" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-dark">Сброс</a>
        </label>
        <div>
            <label for="items-per-page">Items per page</label>
            <select id="items-per-page" name="itemsPerPage" onchange="this.form.submit()">
                <option value="3" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 3)">3</option>
                <option value="5" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 5)">5</option>
                <option value="8" selected="@(Convert.ToInt32(ViewData["ItemsPerPage"]) == 8)">8</option>
            </select>
        </div>
    </form>


    <div>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
</div>
<div class="table-container">
    <table class="table" style="color: white;">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-itemsPerPage="@ViewData["ItemsPerPage"]">

                        @Html.DisplayNameFor(m => Model.First().CourseID)
                    </a>

                </th>
                <th>

                    @Html.DisplayNameFor(m => Model.First().StudentID)
                </th>
                <th>

                    @Html.DisplayNameFor(m => Model.First().Grade)

                </th>
                <th>

                    @Html.DisplayNameFor(m => Model.First().Student)

                </th>
                <th>

                    @Html.DisplayNameFor(m => Model.First().Course)

                </th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) 
{
        <tr>
            <td>
                @Html.DisplayFor(model => item.CourseID)
            </td>
            <td>
                @Html.DisplayFor(model => item.StudentID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(model => item.Student)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EnrollmentID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EnrollmentID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EnrollmentID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
       class="btn btn-outline-light @prevDisabled">
        Prev
    </a>
    <div class="pagination-items">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-pageIndex="@i"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
               class=@(i == Model.PageIndex ? "selected-page" : "pagination-item")>
                @i
            </a>
        }
    </div>
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       asp-route-searchString="@ViewData["CurrentFilter"]"
       asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
       class="btn btn-outline-light @nextDisabled">
        Next
    </a>
</div>

