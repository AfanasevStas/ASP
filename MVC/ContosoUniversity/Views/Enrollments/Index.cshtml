@* @model IEnumerable<ContosoUniversity.Models.Enrollment> *@
@model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Index";
}

<h1>Enrollment</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table" style="color: white;">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.CourseID) *@
                CourseID
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.StudentID) *@
                StudentID
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.Grade) *@
                Grade
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.Student) *@
                Student
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.Course) *@
                Course
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CourseID)
            </td>
            <td>
                @Html.DisplayFor(model => item.StudentID)
            </td>
            <td>
                @Html.DisplayFor(model => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(model => item.Student)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EnrollmentID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EnrollmentID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EnrollmentID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex - 1)"
       class="btn btn-outline-light @prevDisabled">
        Prev
    </a>
    <div class="pagination-items">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-pageIndex="@i"
               class=@(i == Model.PageIndex ? "selected-page" : "pagination-item")>
                @i
            </a>
        }
    </div>
    <a asp-action="Index"
       asp-route-pageIndex="@(Model.PageIndex + 1)"
       class="btn btn-outline-light @nextDisabled">
        Next
    </a>
</div>

